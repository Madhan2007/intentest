# Copy to infra/.env for production / EC2 (docker compose auto-loads .env
# next to the compose file). Dev-docker needs none of this — every value
# here has a laptop-friendly default baked into infra/docker-compose.yml.
# Never commit the real infra/.env (see .gitignore).

# --- Secrets (doc 08 §1) --------------------------------------------------
POSTGRES_PASSWORD=change-me-strong
VALKEY_PASSWORD=change-me-strong

# Optional first-login password. When omitted, an empty PostgreSQL deployment
# generates one random admin password in /etc/opzhub/bootstrap-admin-password.
# Never commit the real infra/.env file.
# OPZHUB_BOOTSTRAP_ADMIN_PASSWORD=

# --- Public port (doc 09 §2) -----------------------------------------------
# HTTPS only — nginx no longer publishes a plaintext HTTP listener.
# Dev default: 8102 (no root needed, no clash with other local stacks).
# Prod / EC2: bind the real public port directly.
OPZHUB_HOST_HTTPS=443

# --- Site/state location (doc 09 §3.1, infra/volumes.md) -----------------
# Dev default: named Docker volumes (etc-opzhub, var-lib-opzhub,
# var-log-opzhub) — portable, no real host paths required.
# Prod / EC2: bind the real host paths created once by
# infra/ec2-bootstrap.sh + infra/wrappers/init-system.sh, so `opzhubctl`
# running directly on the host sees the same files as the containers.
OPZHUB_ETC_SRC=/etc/opzhub
OPZHUB_VARLIB_SRC=/var/lib/opzhub
OPZHUB_VARLOG_SRC=/var/log/opzhub
